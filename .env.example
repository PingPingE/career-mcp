# Public URL of this deployment, no trailing slash. On Vercel this falls back to
# https://$VERCEL_PROJECT_PRODUCTION_URL when unset.
APP_URL=http://localhost:3000

# Random string, at least 32 chars:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Postgres (Neon). Leave empty locally to use an embedded PGlite database in ./.pglite
DATABASE_URL=

# Optional: only this email may create the owner account.
OWNER_EMAIL=

# Which client-registration method the authorization server advertises: dcr | cimd | both
OAUTH_CLIENT_REGISTRATION=dcr
