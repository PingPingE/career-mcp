{
  "name": "career-mcp",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "Career MCP: the owner's career, served to Claude as a remote MCP server",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "sh -c \"if [ -n \\\"$DATABASE_URL\\\" ]; then npm run migrate; else echo skip migrate: no DATABASE_URL; fi\" && next build",
    "start": "next start",
    "migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "import": "node --env-file-if-exists=.env.local --import tsx scripts/import-career.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.18",
    "@better-auth/mcp": "^1.7.18",
    "@better-auth/oauth-provider": "^1.7.18",
    "@electric-sql/pglite": "^0.5.16",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-auth": "^1.7.18",
    "kysely": "^0.29.8",
    "kysely-pglite-dialect": "^1.4.0",
    "mcp-handler": "^2.3.1",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
